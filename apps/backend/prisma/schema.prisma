// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Prisma 7's modern generator. The client is written into src/ as ordinary
  // generated source instead of being injected into node_modules, so it
  // survives dependency pruning and multi-stage Docker copies.
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

model Quack {
  id        String   @id @default(cuid())
  text      String   @db.Text
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@map("quack")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @db.VarChar(255)
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model User {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean
  image           String?   @db.Text
  createdAt       DateTime
  updatedAt       DateTime
  sessions        Session[]
  accounts        Account[]
  quacks          Quack[]
  dogs            Dog[]
  createdGoals    TrainingGoal[] @relation("GoalCreator")
  workoutLogs     WorkoutLog[]   @relation("LogAuthor")
  role            UserRole  @default(user)

  username        String? @db.VarChar(50)
  displayUsername String? @db.VarChar(50)

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Dog {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(40)
  breed       String?  @db.VarChar(100)
  color       Int
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isArchived  Boolean  @default(false)
  disciplines String[] @default([])
  goals       TrainingGoal[]
  workoutLogs WorkoutLog[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([ownerId])
  @@map("dog")
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ARCHIVED

  @@map("goal_status")
}

enum WorkoutStatus {
  COMPLETED
  SKIPPED

  @@map("workout_status")
}

enum FocusLevel {
  YES
  PARTIALLY
  NO

  @@map("focus_level")
}

enum MistakeLevel {
  YES
  PARTIALLY
  NO

  @@map("mistake_level")
}

model TrainingGoal {
  id          String        @id @default(cuid())
  dogId       String
  dog         Dog           @relation(fields: [dogId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User          @relation("GoalCreator", fields: [createdById], references: [id], onDelete: Cascade)
  title       String        @db.VarChar(100)
  discipline  String?       @db.VarChar(60)
  principle   String?       @db.Text
  status      GoalStatus    @default(ACTIVE)
  order       Int           @default(0)
  workoutLogs WorkoutLog[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  @@index([dogId, status])
  @@index([dogId, order])
  @@map("training_goal")
}

model WorkoutLog {
  id               String        @id @default(cuid())
  dogId            String
  dog              Dog           @relation(fields: [dogId], references: [id], onDelete: Cascade)
  goalId           String?
  goal             TrainingGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  authorId         String
  author           User          @relation("LogAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title            String        @db.VarChar(120)
  discipline       String?       @db.VarChar(60)
  status           WorkoutStatus @default(COMPLETED)
  completedAt      DateTime      @default(now())
  successRate      Int?
  rating           Int?
  focus            FocusLevel?
  repeatedMistakes MistakeLevel?
  note             String?       @db.Text
  videoUrl         String?       @db.VarChar(500)
  skipReason       String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt

  @@index([dogId, completedAt(sort: Desc)])
  @@map("workout_log")
}
