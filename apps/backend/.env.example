# Basic Auth Configuration
BETTER_AUTH_SECRET=development_secret_key_change_in_production
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=adminpassword

# Environment Configuration
NODE_ENV=development

# URLs
BACKEND_URL=http://localhost:4050
FRONTEND_URL=http://localhost:3050
FRONTEND_RESET_PASSWORD_ROUTE=reset-password

# Database Configuration
DATABASE_URL=postgresql://quacker:quacker@localhost:5433/quacker

# Server Configuration
PORT=4050

# Mail Configuration
# Resolution order: Resend (if RESEND_API_KEY is set) → SMTP (if SMTP_HOST is set) → Console (dev logs).
# Set RESEND_API_KEY to use Resend (e.g. with onboarding@resend.dev).
RESEND_API_KEY=
EMAIL_FROM="TrainLoop <onboarding@resend.dev>"
# Local SMTP configuration (defaults to Mailpit in Docker: docker compose -f apps/backend/docker-compose.yml up mailpit).
# If SMTP_HOST is omitted, empty, or set to "console", emails are printed to the backend console log instead.
SMTP_HOST=localhost
SMTP_SECURE=false
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD= 